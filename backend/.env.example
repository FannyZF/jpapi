# ==========================================
# Japan Customs API Hub - Environment Config
# ==========================================
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# 服务端口
PORT=3000

# DeepSeek V3 LLM (用于 HS Code 分类)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# QWen 3.6 Plus LLM (双模型共识)
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# SQLite 数据库路径
SQLITE_PATH=./data/cleanse_history.db

# Redis 缓存 (可选，不填则跳过)
REDIS_URL=

# Google Maps Geocoding + Address Validation
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Yahoo Japan Furigana API (可选)
# YAHOO_CLIENT_ID=your-yahoo-client-id

# 速率限制
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# 安全：生产环境必须设为 false
AUTH_BYPASS_LOCALHOST=false

# CORS 允许的来源
CORS_ORIGINS=http://localhost:3000

# Kuromoji 词典路径
KUROMOJI_DICT_PATH=node_modules/kuromoji/dict

# 请求签名验证 (HMAC-SHA256), 默认 false。
# 开启后客户端需携带 X-Signature 头，适用于需要法律级防抵赖的场景。
# 关闭时系统自动记录 request_hash + response_hash 用于审计。 
SIGNATURE_REQUIRED=false
